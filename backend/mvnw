#!/bin/sh
# Maven wrapper script
set -e

MVN_VERSION=3.9.6
MVN_HOME="$HOME/.m2/wrapper/dists/apache-maven-$MVN_VERSION"
MVN_BIN="$MVN_HOME/apache-maven-$MVN_VERSION/bin/mvn"

if [ ! -f "$MVN_BIN" ]; then
    mkdir -p "$MVN_HOME"
    curl -fsSL "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MVN_VERSION/apache-maven-$MVN_VERSION-bin.zip" -o /tmp/maven.zip
    unzip -q /tmp/maven.zip -d "$MVN_HOME"
    rm /tmp/maven.zip
    chmod +x "$MVN_BIN"
fi

exec "$MVN_BIN" "$@"
